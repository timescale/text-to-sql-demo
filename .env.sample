# What model to use for generating the SQL
MODEL=openai:gpt-4.1-nano
# Required as we use OpenAI to handle vectorization of embeddings,
# as well as if you use it for the model.
OPENAI_API_KEY=
# Depending on the model used, uncomment and set appropriate API key
#ANTHROPIC_API_KEY=
#MISTRAL_API_KEY=

# Uncomment and set if you want to run the app outside of our docker-compose setup
# Should point at a postgres database that has pgvector installed
# POSTGRES_DSN=
